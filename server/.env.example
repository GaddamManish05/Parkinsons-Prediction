# Express Server Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/parkinson

# JWT Authentication Secret (MUST be a strong, unique secret in production)
JWT_SECRET=replace_with_a_strong_random_secret_string_in_production

# Python ML Microservice URL
PYTHON_SERVICE_URL=http://127.0.0.1:8000
