# Root Environment Configuration Example (Local Docker Compose and Production Reference)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://mongodb:27017/parkinson
JWT_SECRET=replace_with_a_strong_random_secret_string_in_production
# Python ML Service URL (Local Docker: http://python-ml-service:8000 | Production: https://parkinsons-ml.onrender.com)
PYTHON_SERVICE_URL=http://python-ml-service:8000

# Frontend URL for CORS Allowlist (Local: http://localhost:3000 | Production: https://parkinsons-prediction-phi.vercel.app)
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Transactional Email Configuration (Brevo REST v3 API)
BREVO_API_KEY=replace_with_real_brevo_api_key
EMAIL_FROM=no-reply@parkinson-research.org
EMAIL_FROM_NAME=Parkinson's Assessment Portal
